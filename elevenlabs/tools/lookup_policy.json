{
  "tool_config": {
    "type": "webhook",
    "name": "lookup_policy",
    "description": "Look up an auto policy by policy number. Returns kind policy_found or kind rejected. Call this first.",
    "tool_error_handling_mode": "passthrough",
    "api_schema": {
      "url": "https://local.invalid/v1/policies/{policy_number}",
      "method": "GET",
      "path_params_schema": {
        "policy_number": {
          "type": "string",
          "description": "Policy number exactly as the caller stated it."
        }
      }
    }
  },
  "response_mocks": [
    {
      "mock_result": "{\"kind\":\"policy_found\",\"policy_number\":\"POL-1001\",\"vehicles\":[],\"earliest_effective_date\":\"2026-09-17\"}",
      "is_error": false,
      "parameter_conditions": [
        {
          "path": "policy_number",
          "eval": {
            "type": "exact",
            "expected_value": "POL-1001"
          }
        }
      ]
    },
    {
      "mock_result": "{\"kind\":\"policy_found\",\"policy_number\":\"POL-3003\",\"vehicles\":[],\"earliest_effective_date\":\"2026-09-17\"}",
      "is_error": false,
      "parameter_conditions": [
        {
          "path": "policy_number",
          "eval": {
            "type": "exact",
            "expected_value": "POL-3003"
          }
        }
      ]
    },
    {
      "mock_result": "{\"kind\":\"rejected\",\"code\":\"policy_cancelled\",\"recovery\":\"escalate\",\"message\":\"Policy POL-2002 is cancelled. No change was applied.\"}",
      "is_error": false,
      "parameter_conditions": [
        {
          "path": "policy_number",
          "eval": {
            "type": "exact",
            "expected_value": "POL-2002"
          }
        }
      ]
    },
    {
      "mock_result": "{\"kind\":\"rejected\",\"code\":\"policy_not_found\",\"recovery\":\"ask_caller_again\",\"message\":\"Policy POL-9999 was not found. Ask the caller for the policy number again.\"}",
      "is_error": false,
      "parameter_conditions": [
        {
          "path": "policy_number",
          "eval": {
            "type": "exact",
            "expected_value": "POL-9999"
          }
        }
      ]
    },
    {
      "mock_result": "{\"kind\":\"rejected\",\"code\":\"policy_not_found\",\"recovery\":\"ask_caller_again\",\"message\":\"Policy was not found. Ask the caller for the policy number again.\"}",
      "is_error": false
    }
  ]
}
