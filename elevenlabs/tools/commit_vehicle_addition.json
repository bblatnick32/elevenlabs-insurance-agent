{
  "tool_config": {
    "type": "webhook",
    "name": "commit_vehicle_addition",
    "description": "Apply the latest proposal. Takes only proposal_id. Call only after a verbatim readback and a clear unqualified yes. Returns kind applied or kind rejected.",
